# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vitaliq

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=change_this_to_a_different_long_random_secret
JWT_RESET_EXPIRES_IN=15m

# Seed admin (used by npm run seed:admin)
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@vitaliq.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional SMTP (if unset, emails are logged to the console instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VitalIQ AI <no-reply@vitaliq.local>"

# Phase 3: Python AI/ML service (must match ai-service/.env's INTERNAL_API_KEY exactly)
