# Server
PORT=8000

# MongoDB — same database as the Node backend
MONGO_URI=mongodb://127.0.0.1:27017/vitaliq

# Shared secret that only the Node backend knows. Every request to this
# service must carry this value in the X-Internal-Api-Key header. The
# browser never talks to this service directly.
INTERNAL_API_KEY=x7k2m9p4q8w1z5v3n6t0r8y4u2i9o7a3s5d1f8g6h4j2k0

# Optional: enables LLM-powered summaries and the RAG doctor assistant.
# Without ANY key set below, both features fall back to deterministic,
# template-based output computed from the same structured data (no LLM
# calls made, zero cost, fully functional).
#
# LLM_PROVIDER: "auto" (default) picks Gemini if GEMINI_API_KEY is set,
# else Anthropic if ANTHROPIC_API_KEY is set. Set explicitly to "gemini" or
# "anthropic" to force one even if both keys happen to be set.
LLM_PROVIDER=auto

# Recommended for getting this running for free: Google AI Studio gives a
# genuinely free, no-credit-card API key for Gemini Flash models.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Anthropic's Claude (no perpetual free tier — requires a
# funded account). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Where the trained risk model is stored/loaded from
MODEL_PATH=./model_artifacts/risk_model.joblib
